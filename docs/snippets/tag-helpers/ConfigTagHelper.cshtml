@addTagHelper *, Ramstack.HtmxToolkit

<head>
    <htmx-config />
</head>

@* Renders the settings selected in AddHtmxToolkit and the antiforgery token
   that the Toolkit script adds to HTMX requests:
   <meta name="htmx-config" content='{"timeout":10000}'
         data-antiforgery-request-token="..." ... /> *@
