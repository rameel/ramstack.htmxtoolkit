root = true

[*]
charset = utf-8
indent_size = 4
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true
resharper_csharp_max_line_length = 160

[*.{cshtml,css,yml,props,targets,csproj}]
indent_size = 2

[*.min.js]
insert_final_newline = false

[*.cs]
# IDE0079: Remove unnecessary suppression
dotnet_remove_unnecessary_suppression_exclusions = category:ReSharper

[tests/**.cs]
# CA1707: Identifiers should not contain underscores
# Tests follow the Method_Condition_ExpectedResult naming convention.
dotnet_diagnostic.CA1707.severity = none

# CA1859: Use concrete types when possible for improved performance
# Tests exercise interface contracts and use abstract ASP.NET Core types.
dotnet_diagnostic.CA1859.severity = none
