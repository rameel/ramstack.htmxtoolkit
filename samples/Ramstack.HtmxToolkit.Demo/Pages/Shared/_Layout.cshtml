<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ramstack.HtmxToolkit Demo</title>
    <htmx-config include-antiforgery-token="true" default-swap-style="HtmxSwap.InnerHtml">
        <response-handling code="204" swap="false" />
        <response-handling code="[23].." swap="true" />
        <response-handling code="422" swap="true" />
        <response-handling code="[45].." swap="false" error="true" />
        <response-handling code="..." swap="true" />
    </htmx-config>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            max-width: 960px;
            margin: 0 auto;
            padding: 20px;
            line-height: 1.6;
        }
        section {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }
        section h2 {
            margin-top: 0;
        }
        button, .btn {
            padding: 8px 16px;
            border: 1px solid #ccc;
            border-radius: 4px;
            background: #f5f5f5;
            cursor: pointer;
            font-size: 14px;
        }
        button:hover, .btn:hover {
            background: #e5e5e5;
        }
        #result, .result {
            margin-top: 12px;
            padding: 12px;
            background: #f9f9f9;
            border-radius: 4px;
            min-height: 20px;
        }
        code {
            background: #eee;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <h1>Ramstack.HtmxToolkit Demo</h1>
    @RenderBody()
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script src="@Html.HtmxAntiforgeryScriptPath(debug: true)"></script>
</body>
</html>
