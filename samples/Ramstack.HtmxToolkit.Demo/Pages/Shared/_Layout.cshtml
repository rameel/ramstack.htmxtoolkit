<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>@(ViewData["Title"] ?? "Home") — Ramstack.HtmxToolkit</title>
  <link rel="stylesheet" href="~/css/demo.css"/>

  <htmx-config />
</head>

<body>
<div class="app-shell">
  <aside class="sidebar">
    <a class="brand" asp-page="/Index">
      <img class="brand-mark" src="~/Icon.png" alt="Ramstack.HtmxToolkit"/>
      <span>HtmxToolkit</span>
    </a>

    <nav>
      <p class="nav-label">Build requests</p>
      <a class="nav-link" asp-page="/Examples/UrlTagHelper">01. Razor Pages URLs</a>
      <a class="nav-link" asp-page="/Examples/RouteData">02. Route values</a>
      <a class="nav-link" asp-page="/Examples/HtmxVals">03. Request values</a>
      <a class="nav-link" asp-page="/Examples/Headers">04. Request headers</a>
      <a class="nav-link" asp-page="/Examples/RequestOptions">05. Request options</a>

      <p class="nav-label">Handle requests</p>
      <a class="nav-link" asp-page="/Examples/HtmxRequest">06. HTMX requests</a>
      <a class="nav-link" asp-page="/Examples/Boosted">07. Boosted requests</a>
      <a class="nav-link" asp-page="/Examples/FluentResponse">08. Response control</a>

      <p class="nav-label">Patterns</p>
      <a class="nav-link" asp-page="/Examples/Polling">09. Progress bar</a>
      <a class="nav-link" asp-page="/Examples/Antiforgery">10. Antiforgery</a>
    </nav>
  </aside>

  <main class="main">
    <header class="topbar">
      <button class="menu-toggle" data-menu-toggle>Menu</button>
      <span>Razor Pages &mdash; HTMX 4</span>
    </header>

    <div class="content">@RenderBody()</div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/htmx.org@4.0.0"
        integrity="sha384-BvJpBiO8Kh31EqtJe5DRIeWrHWnCGkwytKs9NKFi86Hhw96dEqdEMzZDeK9iEGTc"
        crossorigin="anonymous"></script>
<script src="@Html.HtmxToolkitScriptPath()"></script>
<script src="~/js/demo.js"></script>
</body>
</html>
