@page
@model RandomModel
@{
  ViewData["Title"] = "On-demand content";
}

<article class="example-page">
  <header class="page-heading">
    <p class="eyebrow">Example 09</p>
    <h1>Load content on demand</h1>
    <p>A compact baseline HTMX interaction using a Razor Page handler</p>
  </header>

  <section class="demo-card">
    <div class="demo-card__header">
      <h2>Random number</h2>
      <p>Click the button to request a fresh server-generated value.</p>
    </div>

    <div class="demo-actions">
      <button
        hx-get
        hx-page="/Examples/Random"
        hx-page-handler="Random"
        hx-target="#random-result">
        Get random number
      </button>
    </div>

    <div id="random-result" class="result">
      No value loaded yet.
    </div>
  </section>
</article>
