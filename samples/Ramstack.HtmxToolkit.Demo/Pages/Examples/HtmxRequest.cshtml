@page
@model HtmxRequestModel
@{
  ViewData["Title"] = "HTMX requests";
}

<article class="example-page">
  <header class="page-heading">
    <p class="eyebrow">Example 06</p>
    <h1>Detect HTMX requests</h1>
    <p>Return a fragment to HTMX and a complete page to normal navigation</p>
  </header>

  <section class="demo-card">
    <div class="demo-card__header">
      <h2><code>Request.IsHtmxRequest()</code></h2>
      <p>Both controls request the same URL; only the HTMX request replaces the result panel.</p>
    </div>

    <div class="demo-actions">
      <button
        hx-get
        hx-page="/Examples/HtmxRequest"
        hx-route-id="1042"
        hx-target="#order-status">
        Check inline
      </button>
      <a
        class="button button-secondary"
        asp-page="/Examples/HtmxRequest"
        asp-route-id="1042"
        target="_blank">
        Open the same URL normally
      </a>
    </div>

    <div id="order-status" class="result">
      @(Model.OrderStatus ?? "Order status has not been requested.")
    </div>
  </section>
</article>
