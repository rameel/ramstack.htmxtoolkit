@page
@model HtmxValsModel
@{
  ViewData["Title"] = "HTMX values";
}

<article class="example-page">
  <header class="page-heading">
    <p class="eyebrow">Example 03</p>
    <h1>Send additional values</h1>
    <p>Add request parameters without writing an <code>hx-vals</code> JSON object</p>
  </header>

  <section class="demo-card">
    <div class="demo-card__header">
      <h2><code>hx-val-*</code> and <code>hx-all-vals</code></h2>
      <p>The toolkit combines individual values or a dictionary into <code>hx-vals</code>.</p>
    </div>

    <div class="demo-actions">
      <button
        hx-get
        hx-page="/Examples/HtmxVals"
        hx-page-handler="Show"
        hx-val-category="science"
        hx-val-format="summary"
        hx-target="#values-result">
        Preview science summary
      </button>
      <button
        class="button button-secondary"
        hx-get
        hx-page="/Examples/HtmxVals"
        hx-page-handler="Show"
        hx-all-vals="@(new Dictionary<string, string> { { "category", "history" }, { "format", "full" } })"
        hx-target="#values-result">
        Preview full history report
      </button>
    </div>

    <div id="values-result" class="result">
      Choose a report preview.
    </div>
  </section>
</article>
