@page
@model PollingModel
@{
  ViewData["Title"] = "Progress bar";
}

<article class="example-page">
  <header class="page-heading">
    <p class="eyebrow">Example 09</p>
    <h1>Progress bar</h1>
    <p>Track a background job with polling controlled by server-rendered HTML</p>
  </header>

  <section class="demo-card">
    <div class="demo-card__header">
      <h2>Background job progress</h2>
      <p>The server updates the bar every 400 ms and stops polling when the job reaches 100%.</p>
    </div>

    <div id="job-progress" class="job-progress job-progress--idle">
      <p>Start the simulated job to see server-controlled polling in action.</p>
      <button hx-post
              hx-page="/Examples/Polling"
              hx-page-handler="Start"
              hx-target="#job-progress"
              hx-swap="outerMorph">
        Start job
      </button>
    </div>
  </section>
</article>
