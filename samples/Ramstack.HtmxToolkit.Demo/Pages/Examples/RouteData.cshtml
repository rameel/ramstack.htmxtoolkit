@page
@model RouteDataModel
@{
  ViewData["Title"] = "Route parameters";
}

<article class="example-page">
  <header class="page-heading">
    <p class="eyebrow">Example 02</p>
    <h1>Pass route values</h1>
    <p>Add route values individually or from a dictionary</p>
  </header>

  <section class="demo-card">
    <div class="demo-card__header">
      <h2><code>hx-route-*</code> and <code>hx-all-route-data</code></h2>
      <p>Both buttons generate a handler URL without assembling a query string.</p>
    </div>

    <div class="demo-actions">
      <button
        hx-get
        hx-page="/Examples/RouteData"
        hx-page-handler="Order"
        hx-route-id="1042"
        hx-target="#order-result">
        Load order #1042
      </button>
      <button
        hx-get
        hx-page="/Examples/RouteData"
        hx-page-handler="Order"
        hx-all-route-data="@(new Dictionary<string, string> { ["id"] = "1088" })"
        hx-target="#order-result"
        class="button-secondary">
        Load order #1088
      </button>
    </div>

    <div id="order-result" class="result">
      Choose an order.
    </div>
  </section>
</article>
